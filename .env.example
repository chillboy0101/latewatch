# Copy to .env.local and fill in. Never commit the filled-in file.

# ---- Authentication (Clerk) ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ---- Database (Neon Postgres) --------------------------------------------
DATABASE_URL=

# ---- File storage (Cloudflare R2) ----------------------------------------
# Holds the Excel templates used to generate exports.
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=

# ---- Realtime (Ably) ------------------------------------------------------
ABLY_API_KEY=

# ---- Push notifications (VAPID) ------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ---- Scheduled reminders --------------------------------------------------
# Shared secret the cron service sends as a bearer token. Long and random.
CRON_SECRET=

# ---- Signing secrets ------------------------------------------------------
# Long random values, independent of every other secret here.
# Changing either one invalidates what it signs: rotating DEVICE_BINDING_SECRET
# unbinds every trusted device and staff must re-register theirs.
DEVICE_BINDING_SECRET=
ATTENDANCE_QR_SECRET=

# ---- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ==========================================================================
# Optional
# ==========================================================================

# Grants admin regardless of Clerk metadata. Comma separated.
# Privileged configuration - treat it like a credential.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Request throttling. Without these the throttle uses Postgres instead.
# The Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Calendar holiday sync, and map display on the location settings page.
GOOGLE_CALENDAR_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Clerk organisation membership sync.
CLERK_ORGANIZATION_ID=
CLERK_ORGANIZATION_MEMBER_ROLE=

# Registers the reminder schedules with the external cron provider.
# Only needed to run `npm run cronjob-org:reminders`.
CRONJOB_ORG_API_KEY=
